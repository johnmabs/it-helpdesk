{
  "name": "it-helpdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "typecheck": "tsc --noEmit",
